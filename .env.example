# Copy to .env.local and fill in.

# --- Database ---------------------------------------------------------------
# Local development: `npm run dev` starts an embedded Postgres (PGlite) on port
# 5433 with data in ./data/pglite, so no install is needed.
# In production use Supabase's pooled ("transaction", port 6543) connection
# string, e.g. postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres

# Production only: Supabase's direct connection (port 5432), used by Vercel
# production builds to apply migrations. Leave unset locally.
# DATABASE_MIGRATION_URL=

# Secret Vercel Cron sends to /api/cron/daily (16+ characters). Production only.
# CRON_SECRET=

# --- Auth -------------------------------------------------------------------
# Public URL of the app (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Random secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Header your hosting proxy sets to the real client IP (it must overwrite any
# value sent by the client). On Vercel use x-real-ip. Leave empty if unsure: IP-based
# limits are then skipped, and per-recipient and global email limits still apply.
TRUSTED_IP_HEADER=

# Universities open to players are listed in src/lib/universities.ts. To open
# only some of them, list their ids, e.g. uwaterloo,utoronto. Unset = all.
# ENABLED_UNIVERSITIES=

# Optional "Continue with Microsoft" (any Microsoft account). Shown when both are set.
# Redirect URI to register in Azure: {BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional "Continue with Google" (any Google account). Shown when both are set.
# Redirect URI to register in Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP connection string for 6-digit codes, e.g. smtps://user:pass@smtp.resend.com:465
# Required in production. Leave empty in local dev (`npm run dev`): codes are
# printed to the console instead.
SMTP_URL=
EMAIL_FROM=Wattle <no-reply@example.com>

# --- Games ------------------------------------------------------------------
# Secret that decides which puzzle each date gets. Required in production.
# Generate with: openssl rand -base64 32
PUZZLE_SECRET=
# Development only: pretend today is this date (YYYY-MM-DD) to test other
# weekdays' games. Ignored in production.
# WATTLE_DEV_DATE=2026-11-16
